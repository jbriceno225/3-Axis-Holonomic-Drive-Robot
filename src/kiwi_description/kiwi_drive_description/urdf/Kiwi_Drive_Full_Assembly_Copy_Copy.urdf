<?xml version="1.0"?>
<robot name="Kiwi_Drive_Full_Assembly_Copy_Copy">

  <!-- Materials -->
  <material name="Steel">
    <color rgba="1.000 1.000 1.000 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.001614 -0.001503 0.068862" rpy="0 0 0"/>
      <mass value="11.692090"/>
      <inertia ixx="3.367127e-01" ixy="-2.167779e-03" ixz="-1.508411e-03"
               iyy="3.398233e-01" iyz="-1.325674e-03" izz="2.870070e-01"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -2.094395"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/base_link/base_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -2.094395"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/base_link/base_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_1_link_Omni_Wheel">
    <inertial>
      <origin xyz="-0.000012 0.000023 0.019966" rpy="0 0 0"/>
      <mass value="1.797779"/>
      <inertia ixx="1.321954e-03" ixy="6.572010e-09" ixz="1.235774e-06"
               iyy="1.321788e-03" iyz="-2.278703e-06" izz="2.173746e-03"/>
    </inertial>
    <visual>
      <origin xyz="-0.088814 0.603225 0.367959" rpy="3.119159 -1.068867 -1.590625"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_1_link/wheel_1_link_Omni_Wheel.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="-0.088814 0.603225 0.367959" rpy="3.119159 -1.068867 -1.590625"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_1_link/wheel_1_link_Omni_Wheel_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_2_link_Omni_Wheel">
    <inertial>
      <origin xyz="0.000013 -0.000005 0.019966" rpy="0 0 0"/>
      <mass value="1.797779"/>
      <inertia ixx="1.321942e-03" ixy="3.160562e-08" ixz="-1.330413e-06"
               iyy="1.321755e-03" iyz="5.539069e-07" izz="2.173771e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.129426 -0.595834 0.367959" rpy="3.119159 -1.068867 1.618682"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_2_link/wheel_2_link_Omni_Wheel.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="0.129426 -0.595834 0.367959" rpy="3.119159 -1.068867 1.618682"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_2_link/wheel_2_link_Omni_Wheel_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_3_link_Omni_Wheel">
    <inertial>
      <origin xyz="-0.000014 -0.000026 0.019967" rpy="0 0 0"/>
      <mass value="1.797779"/>
      <inertia ixx="1.321962e-03" ixy="4.465450e-08" ixz="1.418671e-06"
               iyy="1.321802e-03" iyz="2.397399e-06" izz="2.173733e-03"/>
    </inertial>
    <visual>
      <origin xyz="-0.089816 0.603077 0.367959" rpy="3.119159 -1.068867 -1.588963"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_3_link/wheel_3_link_Omni_Wheel.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="-0.089816 0.603077 0.367959" rpy="3.119159 -1.068867 -1.588963"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/wheel_3_link/wheel_3_link_Omni_Wheel_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="Lidar_Mounting_Plate">
    <inertial>
      <origin xyz="-0.002558 0.020131 0.010134" rpy="0 0 0"/>
      <mass value="1.086176"/>
      <inertia ixx="1.522713e-03" ixy="9.869876e-05" ixz="5.571067e-06"
               iyy="8.842444e-04" iyz="1.271763e-04" izz="1.946043e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/lidar_link/Lidar_Mounting_Plate.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://kiwi_drive_description/meshes/lidar_link/Lidar_Mounting_Plate_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_1_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1_link_Omni_Wheel"/>
    <origin xyz="0.269094 -0.155140 -0.028295" rpy="-1.588336 0.031105 1.057255"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="wheel_2_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2_link_Omni_Wheel"/>
    <origin xyz="-0.000532 0.310563 -0.028788" rpy="1.574419 -0.000039 0.010768"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="wheel_3_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3_link_Omni_Wheel"/>
    <origin xyz="-0.269016 -0.155795 -0.029665" rpy="-1.549628 0.035717 -1.035628"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="base_link_to_lidar_link" type="fixed">
    <parent link="base_link"/>
    <child link="Lidar_Mounting_Plate"/>
    <origin xyz="-0.000151 -0.115009 0.024945" rpy="0.000000 0.000000 0.000000"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Kiwi_Drive_Full_Assembly_Copy_Copy_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/Kiwi_Drive_Full_Assembly_Copy_Copy_system/cmd</param>
      <param name="state_topic">sim/Kiwi_Drive_Full_Assembly_Copy_Copy_system/state</param>
    </hardware>

    <joint name="wheel_1_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_2_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_3_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>