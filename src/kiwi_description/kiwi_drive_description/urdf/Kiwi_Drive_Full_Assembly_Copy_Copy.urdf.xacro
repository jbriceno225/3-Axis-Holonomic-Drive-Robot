<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Kiwi_Drive_Full_Assembly_Copy_Copy">

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="1.000 1.000 1.000 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find kiwi_drive_description)/urdf/assemblies/base_link.urdf.xacro"/>
  <xacro:include filename="$(find kiwi_drive_description)/urdf/assemblies/wheel_1_link.urdf.xacro"/>
  <xacro:include filename="$(find kiwi_drive_description)/urdf/assemblies/wheel_2_link.urdf.xacro"/>
  <xacro:include filename="$(find kiwi_drive_description)/urdf/assemblies/wheel_3_link.urdf.xacro"/>
  <xacro:include filename="$(find kiwi_drive_description)/urdf/assemblies/lidar_link.urdf.xacro"/>
  <!-- Instantiate assemblies -->
  <xacro:base_link prefix=""/>
  <xacro:wheel_1_link prefix=""/>
  <xacro:wheel_2_link prefix=""/>
  <xacro:wheel_3_link prefix=""/>
  <xacro:lidar_link prefix=""/>

  <!-- Mount joints (cross-assembly connections) -->
  <!-- These define how assemblies connect to each other. -->
  <!-- When swapping a dummy assembly with a real part, -->
  <!-- update the include + macro call above, and adjust -->
  <!-- parent/child link names in the mount joint below. -->

  <joint name="wheel_1_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1_link_Omni_Wheel"/>
    <origin xyz="0.269094 -0.155140 -0.028295" rpy="-1.588336 0.031105 1.057255"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="wheel_2_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2_link_Omni_Wheel"/>
    <origin xyz="-0.000532 0.310563 -0.028788" rpy="1.574419 -0.000039 0.010768"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="wheel_3_to_base_link" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3_link_Omni_Wheel"/>
    <origin xyz="-0.269016 -0.155795 -0.029665" rpy="-1.549628 0.035717 -1.035628"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="base_link_to_lidar_link" type="fixed">
    <parent link="base_link"/>
    <child link="Lidar_Mounting_Plate"/>
    <origin xyz="-0.000151 -0.115009 0.024945" rpy="0.000000 0.000000 0.000000"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Kiwi_Drive_Full_Assembly_Copy_Copy_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/Kiwi_Drive_Full_Assembly_Copy_Copy_system/cmd</param>
      <param name="state_topic">sim/Kiwi_Drive_Full_Assembly_Copy_Copy_system/state</param>
    </hardware>

    <joint name="wheel_1_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_2_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_3_to_base_link">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>